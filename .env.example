# Copy this file to .env.local and fill in your own values.
# Get an API key at https://resend.com (free tier is enough for a contact form).
RESEND_API_KEY=

# Optional: override which inbox contact form submissions go to.
# Defaults to the email in lib/site.js if not set.
CONTACT_EMAIL=soulscity.th@gmail.com

# Optional: Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# While this is empty no analytics script loads and no events are sent.
NEXT_PUBLIC_GA_ID=
